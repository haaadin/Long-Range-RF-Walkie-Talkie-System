* Long-Range RF Walkie-Talkie System (Simulation Model at 1 MHz Carrier)
* Blocks: Audio Preamp -> 555 Tone/Modulation Stage -> LC RF Oscillator & PA ->
*         Antenna Coupling -> Tuned RF Amp & Envelope Detector -> Audio Output Stage

* ---------- Power Supply ----------
Vcc vcc 0 DC 9
* Push-to-Talk (PTT) control: 9V = Transmit (TX) active, 0V = Standby/Receive
Vptt ptt 0 PWL(0 0 10u 9 1.5m 9 1.51m 0)

* ---------- 1. Audio Input & Transistor Preamp ----------
* 1 kHz voice-band test tone (100 mV peak) + DC bias network
Vaud aud_in 0 SIN(0 0.1 1k)
Rb1 vcc aud_base 47k
Rb2 aud_base 0 10k
Cin aud_in aud_base 1u
Q_aud aud_col aud_base aud_em NPN_GEN
Re_aud aud_em 0 1k
Ce_aud aud_em 0 47u
Rc_aud vcc aud_col 4.7k
C_ac aud_col mod_node 1u

* ---------- 2. 555 Timer Stage (Roger/Call Tone & Modulation Shaping) ----------
* Astable 555 generating ~2.5 kHz tone bursts gated by PTT
* Pins: 1=GND, 2=TRIG, 3=OUT, 4=RESET, 5=CV, 6=THRES, 7=DISCH, 8=VCC
X555 0 t555_tr t555_out ptt 0 t555_th t555_dis vcc NE555_BEH
R555_1 vcc t555_dis 10k
R555_2 t555_dis t555_th 100k
C555_t t555_th 0 2.2n
* Tie trigger and threshold together for free-running astable operation when RESET (ptt) is high
R555_lk t555_th t555_tr 0
* Mix audio preamp output and 555 tone into modulation bus
R_mix_a mod_node mod_sum 10k
R_mix_555 t555_out mod_sum 22k
R_mix_pd mod_sum 0 10k

* ---------- 3. Transistor RF Oscillator & Class-A/C Driver (TX) ----------
* Colpitts-style LC tank at f0 ≈ 1/(2*pi*sqrt(L_tx * (C_t1*C_t2/(C_t1+C_t2))))
* L_tx = 25.33uH, C_t1 = 2nF, C_t2 = 2nF (C_eq = 1nF) -> f0 ≈ 1.00 MHz
V_tx_en tx_en 0 V=if(V(ptt)>4.5, 1, 0)
L_tx vcc tank_tx 25.33u
C_t1 tank_tx osc_b 2n
C_t2 osc_b 0 2n
Rb_tx1 vcc osc_b 22k
Rb_tx2 osc_b 0 6.8k
Q_osc tank_tx osc_b tx_em RF_NPN
Re_tx tx_em 0 470
Ce_tx tx_em 0 1n

* Amplitude/Base modulation coupling from mod_sum into RF stage
C_mod mod_sum osc_b 100n
* RF Power/Driver stage gated by PTT
R_pa_bias vcc pa_b 15k
C_pa_in tank_tx pa_b 100p
Q_pa pa_col pa_b 0 RF_NPN
L_pa_rfc vcc pa_col 47u
C_pa_out pa_col ant_tx 100p
* Gate PA supply via behavioral switch controlled by PTT
B_pa_gate pa_col_sw 0 V=(V(ptt)>4.5) ? V(pa_col) : 0
R_ant_tx ant_tx ant_rx 50

* ---------- 4. Tuned RF Amplifier, Envelope Detector & Audio Amp (RX) ----------
* Parallel LC tank tuned to ~1 MHz (L_rx = 25.33uH, C_rx = 1nF)
L_rx ant_rx rx_tank 25.33u
C_rx rx_tank 0 1n
R_rx_tank rx_tank 0 2.2k

* Tuned RF input transistor stage
Rb_rx1 vcc rx_b 33k
Rb_rx2 rx_b 0 10k
C_rx_in rx_tank rx_b 100p
Q_rx rx_col rx_b rx_em RF_NPN
Rc_rx vcc rx_col 2.2k
Re_rx rx_em 0 220
Ce_rx rx_em 0 1n

* Diode Envelope Detector + RC low-pass filter (fc ≈ 1 / (2*pi*10k*1nF) ≈ 15.9 kHz)
D_det rx_col det_out D_RF
R_det det_out 0 10k
C_det det_out 0 1n

* Recovered Audio Amplifier & Speaker Load (8 ohm via coupling cap)
C_sp_in det_out sp_b 1u
Rb_sp1 vcc sp_b 27k
Rb_sp2 sp_b 0 8.2k
Q_sp sp_col sp_b sp_em NPN_GEN
Rc_sp vcc sp_col 1k
Re_sp sp_em 0 100
C_sp_out sp_col spk_node 47u
R_spk spk_node 0 8

* ---------- Behavioral 555 Subcircuit ----------
.subckt NE555_BEH gnd trig out reset cv thres dis vcc
* Internal 1/3 Vcc and 2/3 Vcc thresholds
B_hi n_hi 0 V=(V(reset)>1.5) ? ((V(thres) > 0.66*V(vcc)) ? 5 : 0) : 0
B_lo n_lo 0 V=(V(reset)>1.5) ? ((V(trig)  < 0.33*V(vcc)) ? 5 : 0) : 0
* SR latch behavior approximated for astable oscillation
B_q q_int 0 V=(V(reset)<1.5) ? 0 : ((V(n_hi)>2.5) ? 0 : ((V(n_lo)>2.5) ? 5 : V(q_int)))
* Output high near Vcc - 1.5V when Q is high, else near GND
B_out out 0 V=(V(reset)<1.5) ? 0 : ((V(q_int)>2.5) ? (V(vcc)-1.5) : 0.1)
* Discharge pin pulls low when Q is low, high-Z when Q is high
S_dis dis gnd q_int 0 SW_555
.model SW_555 SW(Ron=10 Roff=100Meg Vt=2.5 Vh=0.5)
.ends NE555_BEH

* ---------- Transistor & Diode Models ----------
.model NPN_GEN NPN(IS=1e-14 BF=150 VAF=100)
.model RF_NPN NPN(IS=1e-14 BF=120 TF=0.2n CJC=1.5p CJE=2p VAF=80)
.model D_RF D(IS=1e-11 RS=1.5 CJ0=1p BV=30)

* ---------- Analysis ----------
.tran 50n 2m uic
.end
